{
  "compilerOptions": {
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "ES5",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "declaration": true,
    "lib": [
      "dom",
      "es2017",
      "es5"
    ],
    "moduleResolution": "node",
     "baseUrl": "./"
  },
  "files": [
    "Angular-csv.ts",
    "Angular-csv.spec.ts",
    "custom.d.ts",
    "index.ts"
  ],
  "outDir": "dist",
  "include": [
    "*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}